<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the server settings hold auth headers, so they stay off cloud backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="server_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="server_settings.xml" />
    </device-transfer>
</data-extraction-rules>
